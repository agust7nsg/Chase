{
  "expo": {
    "name": "Chase",
    "slug": "chase",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "chase",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.chase.prototype"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/icon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-camera", { "cameraPermission": "Allow Chase to show the camera while you scan cards.", "microphonePermission": false, "recordAudioAndroid": false, "barcodeScannerEnabled": false }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/brand/icon.png"
  }
}
