# SERVER ONLY. Copy to .env.scanner on the computer running the local proxy.
# Never prefix the vendor key with EXPO_PUBLIC_ or copy it into the mobile app.
CARDSIGHT_API_KEY=
# Optional URL-safe pairing token (24–256 characters). Blank generates one per run.
SCANNER_DEV_TOKEN=
SCANNER_PROXY_PORT=8787
SCANNER_MAX_RUN_REQUESTS=100
SCANNER_MIN_INTERVAL_MS=1500
# Optional comma-separated browser origins. Native requests do not use browser CORS.
SCANNER_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
