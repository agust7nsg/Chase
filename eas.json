{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENABLE_PRO_SIMULATION": "true",
        "EXPO_PUBLIC_SCANNER_BACKEND": "supabase"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_SCANNER_BACKEND": "supabase"
      }
    }
  }
}
