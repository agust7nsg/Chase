# Optional development-only connection to your local scanner proxy. No CardSight API key belongs here.
EXPO_PUBLIC_SCANNER_URL=
EXPO_PUBLIC_SCANNER_TOKEN=
# Hosted scanning is the default, with public project settings bundled in the app.
# Set local explicitly ONLY to use the development proxy in Expo development mode.
EXPO_PUBLIC_SCANNER_BACKEND=supabase

# Supabase client configuration. Use a PUBLIC publishable key, never a secret/service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://vzjekkgyrdxzlhaupnrw.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
